{
  "_source": "inbox config 'public-services' copied from unified-dev MDMS (tenant dev) on 2026-11-12; 'operators-test' is made up to cover WILDCARD, GTE and LTE",
  "MdmsRes": {
    "INBOX": {
      "InboxQueryConfiguration": [
        {
          "index": "public-service-index",
          "module": "public-services",
          "sortBy": {
            "path": "Data.auditDetails.createdTime",
            "defaultOrder": "DESC"
          },
          "sourceFilterPathList": [
            "Data.businessService",
            "Data.applicationNumber",
            "Data.currentProcessInstance",
            "Data.auditDetails",
            "Data.module",
            "Data.locality",
            "Data.status",
            "Data.serviceCode"
          ],
          "allowedSearchCriteria": [
            {
              "name": "status",
              "path": "Data.currentProcessInstance.state.uuid.keyword",
              "isMandatory": false
            },
            {
              "name": "applicationNumber",
              "path": "Data.applicationNumber.keyword",
              "isMandatory": false
            },
            {
              "name": "module",
              "path": "Data.module.keyword",
              "operator": "EQUAL",
              "isMandatory": true
            },
            {
              "name": "businessService",
              "path": "Data.businessService.keyword",
              "operator": "EQUAL",
              "isMandatory": true
            },
            {
              "name": "locality",
              "path": "Data.address.locality.keyword",
              "isMandatory": false
            },
            {
              "name": "assignee",
              "path": "Data.currentProcessInstance.assignes.uuid.keyword",
              "isMandatory": false
            }
          ]
        },
        {
          "index": "operators-index",
          "module": "operators-test",
          "sortBy": {
            "path": "Data.auditDetails.lastModifiedTime",
            "defaultOrder": "ASC"
          },
          "sourceFilterPathList": [
            "Data.applicationNumber",
            "Data.currentProcessInstance",
            "Data.auditDetails"
          ],
          "allowedSearchCriteria": [
            {
              "name": "status",
              "path": "Data.currentProcessInstance.state.uuid.keyword",
              "isMandatory": false
            },
            {
              "name": "tenantId",
              "path": "Data.tenantId.keyword",
              "operator": "EQUAL",
              "isMandatory": true
            },
            {
              "name": "applicantName",
              "path": "Data.applicantName.keyword",
              "operator": "WILDCARD",
              "isMandatory": false
            },
            {
              "name": "fromDate",
              "path": "Data.auditDetails.createdTime",
              "operator": "GTE",
              "isMandatory": false
            },
            {
              "name": "toDate",
              "path": "Data.auditDetails.createdTime",
              "operator": "LTE",
              "isMandatory": false
            },
            {
              "name": "mobileNumber",
              "path": "Data.mobileNumber.keyword",
              "isMandatory": false
            }
          ]
        }
      ]
    }
  }
}